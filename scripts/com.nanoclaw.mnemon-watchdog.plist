<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nanoclaw.mnemon-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/pnpm</string>
    <string>exec</string>
    <string>tsx</string>
    <string>scripts/mnemon-watchdog.ts</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/ss-spare/nanoclaw-v2</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/ss-spare</string>
  </dict>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>/Users/ss-spare/nanoclaw-v2/logs/mnemon-watchdog.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ss-spare/nanoclaw-v2/logs/mnemon-watchdog.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
